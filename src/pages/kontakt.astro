---
import Layout from '../layouts/Layout.astro';
import { 
  Mail, Phone, MapPin, Clock, Send, Users, Shield, Target, ExternalLink, Navigation, CheckCircle2, Receipt, AlertTriangle, FileText
} from 'lucide-react';

const CONTACT_CHANNELS = [
  {
    title: 'Geschäftsführender Vorstand',
    role: 'Allgemeine Vereinsangelegenheiten',
    email: 'vorstand@sg-gersfeld.de',
    icon: 'users'
  },
  {
    title: 'Rechnungen & Buchhaltung',
    role: 'Rechnungseingang, Auslagen, Belege',
    email: 'rechnung@sg-gersfeld.de',
    icon: 'receipt'
  },
  {
    title: 'Mitgliederverwaltung',
    role: 'Aufnahmeanträge, Adressänderungen, Beiträge',
    email: 'mitgliederverwaltung@sg-gersfeld.de',
    icon: 'shield'
  },
  {
    title: 'BDS-Schützen SG Gersfeld',
    role: 'Großkaliber, Speed, Mehrdistanz & BDS-Sport',
    email: 'bds@sg-gersfeld.de',
    icon: 'target'
  },
  {
    title: 'IPSC Schießsport',
    role: 'Dynamic Shooting, Matches & Gastschützen',
    email: 'ipsc@sg-gersfeld.de',
    icon: 'target'
  }
];
---

<Layout title="Kontakt & Anfahrt - SG Gersfeld 1813 e.V." description="Kontaktdaten, E-Mail-Adressen und Anfahrt zum Schützenhaus der Schützengesellschaft Gersfeld 1813 e.V.">
  
  <div class="bg-brand-card min-h-screen pb-24">
    
    {/* Page Header */}
    <header class="bg-brand-bg py-20 border-b border-brand-border/40 px-6 text-center">
      <div class="max-w-3xl mx-auto space-y-4">
        <span class="text-xs font-extrabold tracking-widest uppercase text-brand-steel">
          Wir sind für dich da
        </span>
        <h1 class="text-3xl sm:text-4xl font-extrabold text-brand-dark tracking-tight flex items-center justify-center gap-3">
          <Mail class="w-8 h-8 text-brand-steel" /> Kontakt & Anfahrt
        </h1>
        <p class="text-brand-muted font-medium max-w-2xl mx-auto">
          Hast du Fragen zu unserem Schießsportangebot, zur Mitgliedschaft oder möchtest uns im Schützenhaus besuchen? Nimm gerne Kontakt mit uns auf.
        </p>
      </div>
    </header>

    <div class="max-w-6xl mx-auto px-6 mt-12 space-y-12">

      {/* Main Info Cards Grid */}
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        
        {/* Card 1: Address */}
        <div class="bg-white border border-brand-border/70 rounded-brand-lg p-6 shadow-sm space-y-4 flex flex-col justify-between">
          <div class="space-y-3">
            <div class="w-12 h-12 rounded-xl bg-slate-100 text-brand-steel flex items-center justify-center">
              <MapPin class="w-6 h-6" />
            </div>
            <h3 class="text-lg font-extrabold text-brand-dark">Schützenhaus & Postanschrift</h3>
            <p class="text-xs sm:text-sm text-brand-steel leading-relaxed">
              <strong>Schützengesellschaft Gersfeld 1813 e.V.</strong><br />
              Rommerser Str. 32<br />
              36129 Gersfeld (Rhön)
            </p>
          </div>
          <a 
            href="https://maps.google.com/?q=Rommerser+Str.+32,+36129+Gersfeld" 
            target="_blank" 
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 text-xs font-bold text-brand-steel hover:text-brand-dark pt-2"
          >
            In Google Maps öffnen <ExternalLink class="w-3.5 h-3.5" />
          </a>
        </div>

        {/* Card 2: Phone */}
        <div class="bg-white border border-brand-border/70 rounded-brand-lg p-6 shadow-sm space-y-4 flex flex-col justify-between">
          <div class="space-y-3">
            <div class="w-12 h-12 rounded-xl bg-slate-100 text-brand-steel flex items-center justify-center">
              <Phone class="w-6 h-6" />
            </div>
            <h3 class="text-lg font-extrabold text-brand-dark">Telefon Schützenhaus</h3>
            <p class="text-xs sm:text-sm text-brand-steel leading-relaxed">
              Telefonische Erreichbarkeit im Schützenhaus (während der regulären Schießzeiten):
            </p>
            <p class="text-base font-extrabold text-brand-dark">
              06654 / 1222
            </p>
          </div>
          <span class="text-xs text-brand-muted">
            Außerhalb der Schießzeiten bitte per E-Mail kontaktieren.
          </span>
        </div>

        {/* Card 3: Email */}
        <div class="bg-white border border-brand-border/70 rounded-brand-lg p-6 shadow-sm space-y-4 flex flex-col justify-between">
          <div class="space-y-3">
            <div class="w-12 h-12 rounded-xl bg-slate-100 text-brand-steel flex items-center justify-center">
              <Mail class="w-6 h-6" />
            </div>
            <h3 class="text-lg font-extrabold text-brand-dark">Zentrale E-Mail</h3>
            <p class="text-xs sm:text-sm text-brand-steel leading-relaxed">
              Für allgemeine Anfragen an den Verein und Vorstand:
            </p>
            <a 
              href="mailto:info@sg-gersfeld.de" 
              class="text-base font-extrabold text-brand-steel hover:text-brand-dark hover:underline block"
            >
              info@sg-gersfeld.de
            </a>
          </div>
          <a 
            href="mailto:info@sg-gersfeld.de" 
            class="inline-flex items-center gap-1.5 text-xs font-bold text-brand-steel hover:text-brand-dark pt-2"
          >
            E-Mail schreiben →
          </a>
        </div>

      </div>

      {/* Rechnungsadresse & Buchhaltung Info Box */}
      <div class="bg-gradient-to-br from-amber-50/90 to-amber-100/40 border-2 border-amber-200/90 rounded-brand-lg p-6 sm:p-8 shadow-xs space-y-5">
        <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-4">
          <div class="space-y-2">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-200/80 text-amber-950 text-xs font-black tracking-wide uppercase">
              <Receipt class="w-3.5 h-3.5 text-amber-800" /> Rechnungsadresse & Buchhaltung
            </div>
            <h2 class="text-xl sm:text-2xl font-black text-brand-dark">
              Digitale Rechnungsstellung & Belegeinreichung
            </h2>
            <p class="text-xs sm:text-sm text-brand-content/90 leading-relaxed max-w-3xl">
              Bitte senden Sie Rechnungen, Lieferscheine und Abrechnungsbelege ausschließlich in elektronischer Form (PDF) an unsere zentrale Rechnungsadresse:
            </p>
            <div class="pt-1">
              <a 
                href="mailto:rechnung@sg-gersfeld.de" 
                class="inline-flex items-center gap-2.5 text-base sm:text-lg font-black text-brand-dark bg-white hover:bg-slate-50 border border-amber-300 px-4 py-2.5 rounded-brand transition-all shadow-xs"
              >
                <Mail class="w-5 h-5 text-amber-700" /> rechnung@sg-gersfeld.de
              </a>
            </div>
          </div>
        </div>

        <div class="bg-white/90 border border-amber-300/70 rounded-brand p-4 space-y-1.5 text-xs text-amber-950 leading-relaxed">
          <p class="font-bold flex items-center gap-1.5 text-amber-900 text-xs sm:text-sm">
            <AlertTriangle class="w-4 h-4 text-amber-600 shrink-0" /> Wichtiger Hinweis für Vereinsmitglieder:
          </p>
          <p>
            Bitte reiche alle verauslagten Belege, Einkaufsquittungen und Rechnungen <strong>ausschließlich per E-Mail an rechnung@sg-gersfeld.de</strong> ein. Belege oder Fotos, die per WhatsApp, Messenger, mündlich oder auf anderen Wegen eingereicht werden, können aus buchhalterischen, steuerrechtlichen und Nachweisgründen <strong>nicht bearbeitet oder erstattet</strong> werden.
          </p>
        </div>
      </div>

      {/* Fachbezogene Ansprechpartner */}
      <div class="bg-white rounded-brand-lg border border-brand-border/70 p-6 sm:p-8 shadow-sm space-y-6">
        <div class="border-b border-brand-border/40 pb-4">
          <h2 class="text-2xl font-black text-brand-dark">
            Direkte Ansprechpartner nach Fachbereich
          </h2>
          <p class="text-xs text-brand-muted">
            Wende dich gerne direkt an die zuständige Abteilung:
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {CONTACT_CHANNELS.map(c => (
            <div class="p-5 rounded-brand bg-slate-50 border border-slate-200/80 flex flex-col justify-between space-y-3">
              <div>
                <h3 class="font-extrabold text-brand-dark text-base">{c.title}</h3>
                <p class="text-xs text-brand-muted mt-0.5">{c.role}</p>
              </div>
              <a 
                href={`mailto:${c.email}`} 
                class="inline-flex items-center gap-2 text-xs sm:text-sm font-bold text-brand-steel hover:text-brand-dark transition-colors self-start"
              >
                <Mail class="w-4 h-4 text-brand-steel" /> {c.email}
              </a>
            </div>
          ))}
        </div>
      </div>

      {/* Anfahrt & Lagebeschreibung */}
      <div class="bg-white rounded-brand-lg border border-brand-border/70 p-6 sm:p-8 shadow-sm space-y-6">
        <div class="border-b border-brand-border/40 pb-4 flex items-center justify-between">
          <div>
            <h2 class="text-2xl font-black text-brand-dark flex items-center gap-2">
              <Navigation class="w-6 h-6 text-brand-steel" /> Anfahrt & Lage
            </h2>
            <p class="text-xs text-brand-muted">So findest du unser Schützenhaus in Gersfeld (Rhön)</p>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center">
          <div class="space-y-4 text-sm text-brand-content leading-relaxed">
            <p>
              Unser Schützenhaus und Vereinsgelände liegt idyllisch am <strong>Stadtrand von Gersfeld in Richtung Rommers</strong> (Rommerser Str. 32).
            </p>
            <ul class="space-y-2 text-xs text-brand-steel">
              <li class="flex items-start gap-2">
                <CheckCircle2 class="w-4 h-4 text-brand-steel shrink-0 mt-0.5" />
                <span><strong>Bahn & ÖPNV:</strong> Nur wenige Gehminuten vom Bahnhof Gersfeld (Rhön) entfernt.</span>
              </li>
              <li class="flex items-start gap-2">
                <CheckCircle2 class="w-4 h-4 text-brand-steel shrink-0 mt-0.5" />
                <span><strong>Auto & Parken:</strong> Kostenfreie Parkplätze stehen direkt am Schützenhaus ausreichend zur Verfügung.</span>
              </li>
              <li class="flex items-start gap-2">
                <CheckCircle2 class="w-4 h-4 text-brand-steel shrink-0 mt-0.5" />
                <span><strong>Lage in der Region:</strong> Ca. 10 km von der Wasserkuppe und ca. 30 km von Fulda entfernt (gut erreichbar über die B279).</span>
              </li>
            </ul>
            <div class="pt-2">
              <a 
                href="https://maps.google.com/?q=Sch%C3%BCtzengesellschaft+Gersfeld+1813+e.V.+Rommerser+Str.+32+36129+Gersfeld" 
                target="_blank" 
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 bg-brand-dark hover:bg-brand-steel text-white text-xs font-bold px-4 py-2.5 rounded-brand transition-colors shadow-sm"
              >
                Routenplaner in Google Maps öffnen <ExternalLink class="w-3.5 h-3.5" />
              </a>
            </div>
          </div>

          <div class="rounded-brand-lg overflow-hidden border border-brand-border/80 shadow-inner aspect-[4/3] bg-slate-100 flex items-center justify-center relative">
            <iframe 
              src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2557.733596238622!2d9.91428!3d50.4468!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x47a324314c1d2e1b%3A0x6b1b4cbcfc2ef3b5!2sRommerser%20Str.%2032%2C%2036129%20Gersfeld%20(Rh%C3%B6n)!5e0!3m2!1sde!2sde!4v1600000000000!5m2!1sde!2sde"
              class="w-full h-full border-0" 
              loading="lazy" 
              referrerpolicy="no-referrer-when-downgrade"
              title="Karte Schützenhaus Gersfeld"
            ></iframe>
          </div>
        </div>
      </div>

    </div>

  </div>

</Layout>

---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { 
  Target, Crosshair, Zap, UserPlus, Clock, ArrowRight, Calendar, ArrowUpRight, Video 
} from 'lucide-react';

// Query latest 3 posts dynamically
const allPosts = await getCollection('posts');
const sortedPosts = allPosts
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const latestPosts = sortedPosts.slice(0, 3);

const formatDate = (date: Date) => {
  return date.toLocaleDateString('de-DE', { year: 'numeric', month: '2-digit', day: '2-digit' });
};

const extractFirstImage = (body: string) => {
  const mdMatch = body.match(/!\[.*?\]\((https?:\/\/[^\s\)]+|\/[^\s\)]+)\)/);
  if (mdMatch && mdMatch[1]) return mdMatch[1];
  const htmlMatch = body.match(/<img[^>]+src=["'](https?:\/\/[^"'>]+|\/[^"'>]+)["']/i);
  if (htmlMatch && htmlMatch[1]) return htmlMatch[1];
  return '/images/schuetzenhaus-gersfeld.jpg';
};

const getCleanSummary = (body: string) => {
  return body
    .replace(/!\[.*?\]\(.*?\)/g, '')
    .replace(/\[.*?\]\(.*?\)/g, '')
    .replace(/\[caption.*?\]/g, '')
    .replace(/\[\/caption\]/g, '')
    .replace(/<[^>]*>/g, '')
    .replace(/[#*`_\[\]()]/g, '')
    .trim()
    .substring(0, 120);
};
---

<Layout title="Schützengesellschaft Gersfeld 1813 e.V.">
  
  <!-- 1. Stunning Hero Section -->
  <section class="relative min-h-[550px] flex items-center justify-center bg-slate-950 overflow-hidden py-24 px-6 text-center">
    <div class="absolute inset-0 bg-cover bg-center bg-no-repeat opacity-45 select-none pointer-events-none scale-105" style="background-image: url('/images/hero-schiessstand.jpg');"></div>
    <div class="absolute inset-0 bg-gradient-to-b from-slate-950/70 via-slate-950/60 to-slate-950/90 pointer-events-none"></div>
    
    <div class="relative max-w-4xl mx-auto z-10 space-y-6">
      <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-bold tracking-wider uppercase text-slate-300 bg-white/10 backdrop-blur-sm border border-white/10 select-none">
        <Target class="w-3.5 h-3.5 text-brand-steel animate-pulse" /> Gegründet 1813 in der Rhön
      </span>
      <h1 class="text-4xl sm:text-5xl md:text-6xl font-black text-white tracking-tight leading-[1.1] text-shadow-md">
        Schützengesellschaft<br />Gersfeld 1813 e.V.
      </h1>
      <p class="text-lg sm:text-xl text-slate-200 max-w-2xl mx-auto font-medium leading-relaxed">
        Tradition und moderner Schießsport im Herzen der Rhön. Entdecke unsere modernen Schießstände und vielfältigen Disziplinen.
      </p>
      <div class="pt-4 flex flex-wrap items-center justify-center gap-4">
        <a href="/verein/mitglied-werden/" class="flex items-center gap-2 bg-white text-brand-dark hover:bg-slate-200 px-6 py-3.5 rounded-brand font-bold text-sm shadow-md transition-all duration-200 hover:-translate-y-0.5 hover:shadow-lg">
          <UserPlus class="w-4 h-4" /> Mitglied werden
        </a>
        <a href="/verein/schiesszeiten/" class="flex items-center gap-2 bg-white/10 hover:bg-white/20 text-white border border-white/20 backdrop-blur-sm px-6 py-3.5 rounded-brand font-bold text-sm transition-all duration-200 hover:-translate-y-0.5">
          <Clock class="w-4 h-4" /> Schießzeiten ansehen
        </a>
      </div>
    </div>
  </section>

  <!-- Live Widget: Nächste Schießzeit -->
  <section class="relative -mt-12 z-20 max-w-5xl mx-auto px-6 mb-8">
    <div class="bg-white rounded-brand-lg border border-brand-border/80 shadow-xl p-6 sm:p-8 flex flex-col md:flex-row items-center justify-between gap-8">
      <div class="space-y-3 max-w-md">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold bg-green-50 text-green-700 border border-green-200">
          <span class="w-2 h-2 rounded-full bg-green-500 animate-pulse"></span> Live aus dem Dienstplan
        </div>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-brand-dark tracking-tight">
          Nächste Schießzeit
        </h2>
        <p class="text-sm text-brand-steel leading-relaxed">
          Aktuelle Übersicht zum nächsten Trainingsabend inklusive Disziplin und eingeteilter Standaufsicht.
        </p>
        <div class="pt-2 flex flex-wrap items-center gap-4 text-xs font-bold">
          <a href="https://dp.sg-gersfeld.de/" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-brand-bg text-brand-steel hover:text-brand-dark hover:bg-brand-steel/10 transition-colors">
            Dienstplan aufrufen <ArrowUpRight class="w-3.5 h-3.5" />
          </a>
          <a href="/verein/schiesszeiten/" class="inline-flex items-center gap-1 text-brand-steel hover:text-brand-dark transition-colors">
            Alle Schießzeiten <ArrowRight class="w-3.5 h-3.5" />
          </a>
        </div>
      </div>
      <div class="w-full md:w-[380px] shrink-0">
        <iframe 
          src="https://dp.sg-gersfeld.de/widget2.php" 
          class="w-full h-[195px] rounded-xl border border-slate-100 shadow-sm" 
          loading="lazy" 
          title="Nächste Schießzeit Live-Widget"
          scrolling="no"
        ></iframe>
      </div>
    </div>
  </section>

  <!-- 2. Welcome Section -->
  <section class="bg-brand-card py-24 px-6 border-b border-brand-border/40">
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
      <div class="space-y-6">
        <span class="text-xs font-extrabold tracking-widest uppercase text-brand-steel">
          Willkommen im Verein
        </span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-brand-dark tracking-tight leading-tight">
          Kameradschaft, Tradition und Schießsport-Präzision
        </h2>
        <div class="space-y-4 text-brand-content text-base sm:text-lg leading-relaxed">
          <p>
            Wir sind ein moderner Schützenverein mit langer Tradition und bieten ein umfangreiches Sportprogramm an, welches keine schießsportlichen Wünsche offenlässt. Bei uns können fast alle Disziplinen sowohl des „Deutschen Schützenbundes“ als auch des „Bundes deutscher Sportschützen“ sowie „IPSC“ geschossen werden.
          </p>
          <p>
            Unsere Schießstände sind auf dem neuesten technischen Stand. Sowohl der 25-Meter- als auch der 50-Meter-Stand sind mehrdistanzfähig, für das sportliche Klein- und Großkaliberschießen zugelassen und mit modernen Fallscheibenanlagen ausgestattet.
          </p>
        </div>
        <div class="pt-4">
          <a href="/verein/" class="inline-flex items-center gap-2 px-5 py-3 border-2 border-brand-steel text-brand-steel hover:bg-brand-steel hover:text-white rounded-brand font-bold text-sm transition-all duration-200 hover:-translate-y-0.5">
            Mehr über uns erfahren <ArrowRight class="w-4 h-4" />
          </a>
        </div>
      </div>
      <div class="relative group">
        <div class="absolute -inset-2 bg-gradient-to-tr from-brand-steel/10 to-brand-muted/10 rounded-brand-lg blur-xl opacity-60 group-hover:opacity-100 transition-opacity duration-500"></div>
        <img 
          src="/images/schuetzenhaus-gersfeld.jpg" 
          alt="Schützenhaus Gersfeld"
          class="relative w-full h-auto rounded-brand-lg border border-brand-border/60 shadow-lg"
        />
      </div>
    </div>
  </section>

  <!-- 3. Sportliche Abteilungen Grid -->
  <section class="bg-brand-bg py-24 px-6 border-b border-brand-border/40">
    <div class="max-w-7xl mx-auto space-y-16">
      <div class="text-center max-w-2xl mx-auto space-y-4">
        <span class="text-xs font-extrabold tracking-widest uppercase text-brand-steel">
          Sportliche Vielfalt
        </span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-brand-dark tracking-tight">
          Unsere sportlichen Abteilungen
        </h2>
        <p class="text-brand-muted font-medium">
          Finde die Schießsport-Disziplin, die zu dir passt – vom statischen Präzisionsschießen bis zum hochdynamischen Parcours.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        
        <!-- Card 1: DSB -->
        <div class="bg-brand-card rounded-brand border border-brand-border/60 p-8 shadow-sm flex flex-col hover:-translate-y-1.5 hover:shadow-md hover:border-brand-steel/30 transition-all duration-300 group">
          <div class="w-12 h-12 rounded-xl bg-slate-100 flex items-center justify-center text-brand-steel mb-6 group-hover:scale-110 group-hover:bg-brand-dark group-hover:text-white transition-all duration-300">
            <Target class="w-6 h-6" />
          </div>
          <h3 class="text-xl font-extrabold text-brand-dark mb-3">
            DSB (Präzision)
          </h3>
          <p class="text-sm leading-relaxed text-brand-content mb-6 flex-grow">
            Klassisches, olympisches Sportschießen mit Fokus auf Konzentration, Ruhe und perfekte Abzugstechnik. Luftgewehr (10m), Kleinkaliber (50m) und traditionelle Kurzwaffendisziplinen.
          </p>
          <a href="/abteilungen/dsb/" class="inline-flex items-center gap-1.5 text-sm font-bold text-brand-steel group-hover:text-brand-dark transition-colors">
            Details ansehen <ArrowUpRight class="w-4 h-4 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
          </a>
        </div>

        <!-- Card 2: BDS -->
        <div class="bg-brand-card rounded-brand border border-brand-border/60 p-8 shadow-sm flex flex-col hover:-translate-y-1.5 hover:shadow-md hover:border-brand-steel/30 transition-all duration-300 group">
          <div class="w-12 h-12 rounded-xl bg-slate-100 flex items-center justify-center text-brand-steel mb-6 group-hover:scale-110 group-hover:bg-brand-dark group-hover:text-white transition-all duration-300">
            <Crosshair class="w-6 h-6" />
          </div>
          <h3 class="text-xl font-extrabold text-brand-dark mb-3">
            BDS (Großkaliber)
          </h3>
          <p class="text-sm leading-relaxed text-brand-content mb-6 flex-grow">
            Dynamischer und vielseitiger Großkalibersport. Speed-Schießen auf Fallscheiben, Mehrdistanz und anspruchsvolle Kurz- und Langwaffen-Disziplinen nach dem Sporthandbuch des BDS.
          </p>
          <a href="/abteilungen/bds/" class="inline-flex items-center gap-1.5 text-sm font-bold text-brand-steel group-hover:text-brand-dark transition-colors">
            Details ansehen <ArrowUpRight class="w-4 h-4 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
          </a>
        </div>

        <!-- Card 3: IPSC -->
        <div class="bg-brand-card rounded-brand border border-brand-border/60 p-8 shadow-sm flex flex-col hover:-translate-y-1.5 hover:shadow-md hover:border-brand-steel/30 transition-all duration-300 group">
          <div class="w-12 h-12 rounded-xl bg-slate-100 flex items-center justify-center text-brand-steel mb-6 group-hover:scale-110 group-hover:bg-brand-dark group-hover:text-white transition-all duration-300">
            <Zap class="w-6 h-6" />
          </div>
          <h3 class="text-xl font-extrabold text-brand-dark mb-3">
            IPSC (Dynamisch)
          </h3>
          <p class="text-sm leading-relaxed text-brand-content mb-6 flex-grow">
            Die absolute Königsklasse des dynamischen Schießens: Präzision, Kraft und Schnelligkeit. Parcoursschießen in freier Bewegung und unter hohem Zeitdruck auf wechselnde Ziele.
          </p>
          <a href="/abteilungen/ipsc/" class="inline-flex items-center gap-1.5 text-sm font-bold text-brand-steel group-hover:text-brand-dark transition-colors">
            Details ansehen <ArrowUpRight class="w-4 h-4 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
          </a>
        </div>

      </div>

      <div class="text-center">
        <a href="/abteilungen/" class="inline-flex items-center gap-2 px-6 py-3 border-2 border-brand-steel text-brand-steel hover:bg-brand-steel hover:text-white rounded-brand font-bold text-sm transition-all duration-200 hover:-translate-y-0.5">
          Alle 5 Sport-Abteilungen ansehen
        </a>
      </div>
    </div>
  </section>

  <!-- Video Section -->
  <section class="bg-brand-bg py-20 px-6 border-t border-b border-brand-border/40">
    <div class="max-w-5xl mx-auto space-y-8">
      <div class="text-center max-w-2xl mx-auto space-y-3">
        <span class="text-xs font-extrabold tracking-widest uppercase text-brand-steel">
          Impressionen & Schießbetrieb
        </span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-brand-dark tracking-tight flex items-center justify-center gap-3">
          <Video class="w-8 h-8 text-brand-steel" /> Unser Verein im Video
        </h2>
        <p class="text-brand-muted font-medium text-sm sm:text-base">
          Erlebe die Schützengesellschaft Gersfeld in Bild und Ton: Schießstände, Disziplinen und Vereinsleben.
        </p>
      </div>

      <div class="relative w-full aspect-video rounded-brand-lg overflow-hidden border border-brand-border/80 shadow-xl bg-black">
        <iframe 
          src="https://www.youtube-nocookie.com/embed/gRcAN3tkrT4" 
          title="Schützengesellschaft Gersfeld 1813 e.V. Vorstellung" 
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
          allowfullscreen
          class="w-full h-full border-0"
        ></iframe>
      </div>
    </div>
  </section>

  <!-- 4. Curated Latest News Section -->
  <section class="bg-brand-card py-24 px-6">
    <div class="max-w-7xl mx-auto space-y-16">
      <div class="text-center max-w-2xl mx-auto space-y-4">
        <span class="text-xs font-extrabold tracking-widest uppercase text-brand-steel">
          Aktuelles Geschehen
        </span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-brand-dark tracking-tight">
          Neuigkeiten aus dem Verein
        </h2>
        <p class="text-brand-muted font-medium">
          Bleibe auf dem Laufenden über sportliche Vereinserfolge, Schützenfeste, Arbeitseinsätze und Termine.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {latestPosts.map(post => {
          const thumbnail = extractFirstImage(post.body);
          const validCats = (post.data.categories || []).filter(c => c.toLowerCase() !== 'uncategorized');
          const category = validCats.length > 0 ? validCats[0] : null;
          const slug = post.slug.replace(/^.*\//, '');

          return (
            <article class="bg-brand-card border border-brand-border/60 rounded-brand-lg overflow-hidden shadow-sm flex flex-col hover:-translate-y-1.5 hover:shadow-xl hover:border-brand-steel/30 transition-all duration-300 group">
              <a href={`/posts/${slug}/`} class="relative block aspect-[16/10] bg-slate-950 overflow-hidden">
                <img 
                  src={thumbnail} 
                  alt={post.data.title}
                  class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105 opacity-90 group-hover:opacity-100"
                  loading="lazy"
                  onerror="this.src='/images/schuetzenhaus-gersfeld.jpg'"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>
                {category && (
                  <span class="absolute top-3 left-3 text-xs font-bold bg-black/60 backdrop-blur-sm text-white px-2.5 py-1 rounded">
                    {category}
                  </span>
                )}
                <span class="absolute bottom-3 left-3 text-xs font-bold text-white/90 flex items-center gap-1.5 backdrop-blur-sm bg-black/40 px-2 py-0.5 rounded">
                  <Calendar class="w-3.5 h-3.5" /> {formatDate(post.data.date)}
                </span>
              </a>
              <div class="p-6 flex flex-col flex-grow justify-between space-y-4">
                <div class="space-y-2">
                  <h3 class="text-lg font-extrabold text-brand-dark group-hover:text-brand-steel transition-colors leading-snug">
                    <a href={`/posts/${slug}/`}>{post.data.title}</a>
                  </h3>
                  <p class="text-sm leading-relaxed text-brand-content/90 line-clamp-3">
                    {getCleanSummary(post.body)}...
                  </p>
                </div>
                <div class="pt-3 border-t border-brand-border/40">
                  <a href={`/posts/${slug}/`} class="inline-flex items-center gap-1 text-sm font-bold text-brand-steel group-hover:text-brand-dark transition-colors">
                    Weiterlesen <ArrowRight class="w-4 h-4 transition-transform group-hover:translate-x-1" />
                  </a>
                </div>
              </div>
            </article>
          );
        })}
      </div>

      <div class="text-center">
        <a href="/posts/" class="inline-flex items-center gap-2 px-6 py-3 border-2 border-brand-steel text-brand-steel hover:bg-brand-steel hover:text-white rounded-brand font-bold text-sm transition-all duration-200 hover:-translate-y-0.5">
          Alle Berichte und News lesen
        </a>
      </div>
    </div>
  </section>

</Layout>
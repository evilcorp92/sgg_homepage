---
import Layout from '../../layouts/Layout.astro';
import { getCalendarEvents, type CalendarEvent } from '../../data/calendar';
import { 
  Calendar as CalendarIcon, Clock, Filter, ExternalLink, Download, Hammer, Users, Trophy, ShieldCheck, MapPin, Search, CalendarRange 
} from 'lucide-react';

const allEvents = await getCalendarEvents();

// Filter strictly for upcoming and ongoing events, sort chronologically ascending
const now = new Date();
const todayStart = new Date(now.getFullYear(), now.getMonth(), now.getDate()).getTime();

const getEventDisplayDetails = (e: CalendarEvent, todayMidnight: number) => {
  const start = e.startDate;
  let inclusiveEnd = e.endDate ? new Date(e.endDate.getTime()) : new Date(start.getTime());
  let durationDays = 1;
  let isMultiDay = false;

  if (e.isAllDay) {
    if (e.endDate) {
      // In RFC 5545, all-day DTEND is exclusive
      const diffMs = e.endDate.getTime() - start.getTime();
      const rawDays = Math.round(diffMs / (1000 * 60 * 60 * 24));
      if (rawDays > 1) {
        durationDays = rawDays;
        isMultiDay = true;
        // Last inclusive calendar day is endDate minus 12 hours (previous calendar day)
        inclusiveEnd = new Date(e.endDate.getTime() - 12 * 60 * 60 * 1000);
      } else {
        durationDays = 1;
        isMultiDay = false;
        inclusiveEnd = new Date(start.getTime());
      }
    }
  } else {
    if (e.endDate) {
      const startMidnight = new Date(start.getFullYear(), start.getMonth(), start.getDate()).getTime();
      const endMidnight = new Date(e.endDate.getFullYear(), e.endDate.getMonth(), e.endDate.getDate()).getTime();
      const dayDiff = Math.round((endMidnight - startMidnight) / (1000 * 60 * 60 * 24)) + 1;
      if (dayDiff > 1) {
        durationDays = dayDiff;
        isMultiDay = true;
        inclusiveEnd = e.endDate;
      }
    }
  }

  // Format month & day for the date tile
  const startMonthStr = start.toLocaleDateString('de-DE', { month: 'short' }).replace('.', '').toUpperCase();
  const endMonthStr = inclusiveEnd.toLocaleDateString('de-DE', { month: 'short' }).replace('.', '').toUpperCase();
  
  let badgeMonth = startMonthStr;
  let badgeDay = String(start.getDate());

  if (isMultiDay) {
    const pad = (n: number) => String(n).padStart(2, '0');
    if (durationDays > 7) {
      badgeMonth = start.getMonth() === inclusiveEnd.getMonth() ? startMonthStr : `${startMonthStr}/${endMonthStr}`;
      badgeDay = `${start.getDate()}.+`;
    } else if (start.getMonth() === inclusiveEnd.getMonth()) {
      badgeDay = `${pad(start.getDate())}–${pad(inclusiveEnd.getDate())}`;
    } else {
      badgeMonth = `${startMonthStr}/${endMonthStr}`;
      badgeDay = `${pad(start.getDate())}.–${pad(inclusiveEnd.getDate())}.`;
    }
  }

  // Format Date Range
  const formatSingleDate = (d: Date) => d.toLocaleDateString('de-DE', { weekday: 'short', day: '2-digit', month: '2-digit', year: 'numeric' });
  let dateRangeStr = formatSingleDate(start);

  if (isMultiDay) {
    dateRangeStr = `${formatSingleDate(start)} – ${formatSingleDate(inclusiveEnd)}`;
  }

  // Format Time
  let timeStr = '';
  const formatTimeOnly = (d: Date) => d.toLocaleTimeString('de-DE', { hour: '2-digit', minute: '2-digit' }) + ' Uhr';
  if (e.isAllDay) {
    timeStr = isMultiDay ? `Ganztägig · ${durationDays} Tage` : 'Ganztägig';
  } else {
    if (isMultiDay) {
      const startWd = start.toLocaleDateString('de-DE', { weekday: 'short' });
      const endWd = inclusiveEnd.toLocaleDateString('de-DE', { weekday: 'short' });
      timeStr = `${startWd}, ${formatTimeOnly(start)} – ${endWd}, ${formatTimeOnly(inclusiveEnd)}`;
    } else if (e.endDate && e.endDate.getTime() > start.getTime()) {
      timeStr = `${formatTimeOnly(start)} – ${formatTimeOnly(e.endDate)}`;
    } else {
      timeStr = formatTimeOnly(start);
    }
  }

  const startDayTime = new Date(start.getFullYear(), start.getMonth(), start.getDate()).getTime();
  const endDayTime = new Date(inclusiveEnd.getFullYear(), inclusiveEnd.getMonth(), inclusiveEnd.getDate()).getTime();
  const isCurrentlyRunning = (startDayTime <= todayMidnight && endDayTime >= todayMidnight && isMultiDay);
  
  let currentDayNumber: number | undefined = undefined;
  if (isCurrentlyRunning) {
    const elapsedDays = Math.round((todayMidnight - startDayTime) / (1000 * 60 * 60 * 24)) + 1;
    currentDayNumber = Math.min(Math.max(elapsedDays, 1), durationDays);
  }

  return {
    isMultiDay,
    durationDays,
    inclusiveEnd,
    badgeMonth,
    badgeDay,
    dateRangeStr,
    timeStr,
    isCurrentlyRunning,
    currentDayNumber
  };
};

const upcomingEvents = allEvents
  .filter(e => {
    const timing = getEventDisplayDetails(e, todayStart);
    const endDayTime = new Date(timing.inclusiveEnd.getFullYear(), timing.inclusiveEnd.getMonth(), timing.inclusiveEnd.getDate()).getTime();
    return endDayTime >= todayStart;
  })
  .sort((a, b) => a.startDate.getTime() - b.startDate.getTime());

// Count for each category
const allgemeinCount = upcomingEvents.filter(e => e.category === 'Allgemein').length;
const vorstandCount = upcomingEvents.filter(e => e.summary.toLowerCase().includes('vorstandssitzung') || e.category === 'Vorstandssitzung').length;
const meisterschaftCount = upcomingEvents.filter(e => /\b(vm|bm|lm)\b|meisterschaft/i.test(e.summary) || e.category === 'Meisterschaft').length;
const arbeitseinsatzCount = upcomingEvents.filter(e => e.summary.toLowerCase().includes('arbeitseinsatz') || e.category === 'Arbeitseinsatz').length;

const CALENDAR_EMBED_URL = "https://calendar.google.com/calendar/embed?src=9edol05k9ov7vnr7o9idllguk0%40group.calendar.google.com&ctz=Europe%2FBerlin&showTitle=0&showNav=1&showDate=1&showPrint=0&showTabs=1&showCalendars=0&showTz=0";
const GOOGLE_CALENDAR_ADD_URL = "https://calendar.google.com/calendar/u/0?cid=OWVkb2wwNWs5b3Y3dm5yN285aWRsbGd1azBAZ3JvdXAuY2FsZW5kYXIuZ29vZ2xlLmNvbQ";
const ICAL_URL = "https://calendar.google.com/calendar/ical/9edol05k9ov7vnr7o9idllguk0%40group.calendar.google.com/public/basic.ics";
---

<Layout title="Termine & Vereinskalender - SG Gersfeld 1813 e.V." description="Kommende Vereinstermine aus dem Google Kalender der SG Gersfeld: Vorstandssitzungen, Meisterschaften (VM, BM, LM), Feste und Arbeitseinsätze.">
  
  <div class="bg-brand-card min-h-screen pb-24">
    
    {/* Page Header */}
    <header class="bg-brand-bg py-20 border-b border-brand-border/40 px-6 text-center">
      <div class="max-w-3xl mx-auto space-y-4">
        <span class="text-xs font-extrabold tracking-widest uppercase text-brand-steel">
          Vereinsleben & Kalender
        </span>
        <h1 class="text-3xl sm:text-4xl font-extrabold text-brand-dark tracking-tight flex items-center justify-center gap-3">
          <CalendarIcon class="w-8 h-8 text-brand-steel" /> Anstehende Vereinstermine
        </h1>
        <p class="text-brand-muted font-medium max-w-2xl mx-auto">
          Alle kommenden Termine synchronisiert aus unserem Google-Kalender. Nach Datum sortiert und mit Schnellfiltern für Vorstandssitzungen, Meisterschaften und Arbeitseinsätze.
        </p>
      </div>
    </header>

    <div class="max-w-5xl mx-auto px-6 mt-12 space-y-10">

      {/* Filter Toolbar & Search Bar */}
      <div class="bg-white rounded-brand-lg border border-brand-border/80 p-6 shadow-sm space-y-6">
        
        {/* Category Buttons: Default is Alle */}
        <div class="flex flex-wrap items-center justify-center gap-2.5">
          <button 
            onclick="setFilter('all')" 
            id="btn-all"
            class="filter-btn active px-4 py-2 rounded-full text-xs sm:text-sm font-bold transition-all bg-brand-dark text-white shadow-sm"
          >
            Alle ({upcomingEvents.length})
          </button>
          <button 
            onclick="setFilter('Allgemein')" 
            id="btn-Allgemein"
            class="filter-btn px-4 py-2 rounded-full text-xs sm:text-sm font-bold transition-all bg-slate-100 text-brand-steel hover:bg-slate-200"
          >
            🎯 Allgemein ({allgemeinCount})
          </button>
          <button 
            onclick="setFilter('Vorstandssitzung')" 
            id="btn-Vorstandssitzung"
            class="filter-btn px-4 py-2 rounded-full text-xs sm:text-sm font-bold transition-all bg-slate-100 text-brand-steel hover:bg-slate-200"
          >
            👥 Vorstandssitzungen ({vorstandCount})
          </button>
          <button 
            onclick="setFilter('Meisterschaft')" 
            id="btn-Meisterschaft"
            class="filter-btn px-4 py-2 rounded-full text-xs sm:text-sm font-bold transition-all bg-slate-100 text-brand-steel hover:bg-slate-200"
          >
            🏆 Meisterschaften ({meisterschaftCount})
          </button>
          <button 
            onclick="setFilter('Arbeitseinsatz')" 
            id="btn-Arbeitseinsatz"
            class="filter-btn px-4 py-2 rounded-full text-xs sm:text-sm font-bold transition-all bg-slate-100 text-brand-steel hover:bg-slate-200"
          >
            🔨 Arbeitseinsätze ({arbeitseinsatzCount})
          </button>
        </div>

        {/* Search Input & Action Bar */}
        <div class="flex flex-col sm:flex-row items-center justify-between gap-4 pt-4 border-t border-brand-border/40">
          <div class="relative w-full sm:w-80">
            <Search class="w-4 h-4 text-slate-400 absolute left-3.5 top-1/2 -translate-y-1/2 pointer-events-none" />
            <input 
              type="text" 
              id="eventSearch" 
              placeholder="Termin suchen (z.B. Arbeitseinsatz, Trap)..."
              oninput="handleSearch()"
              class="w-full pl-10 pr-4 py-2 text-xs sm:text-sm rounded-brand border border-brand-border/80 focus:border-brand-dark focus:ring-1 focus:ring-brand-dark outline-none bg-slate-50"
            />
          </div>

          <div class="flex flex-wrap items-center gap-2 self-stretch sm:self-auto justify-end">
            <a 
              href={GOOGLE_CALENDAR_ADD_URL}
              target="_blank" 
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-brand bg-white hover:bg-brand-steel/10 text-brand-steel hover:text-brand-dark border border-brand-border/80 text-xs font-bold transition-all shadow-sm"
            >
              <ExternalLink class="w-3.5 h-3.5" /> In Google Kalender öffnen
            </a>
            <a 
              href={ICAL_URL}
              class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-brand bg-brand-dark hover:bg-brand-steel text-white text-xs font-bold transition-all shadow-sm"
            >
              <Download class="w-3.5 h-3.5" /> iCal (.ics)
            </a>
          </div>
        </div>

      </div>

      {/* Events List Container */}
      <div class="space-y-4" id="eventsContainer">
        <div id="eventsCounter" class="text-xs font-bold text-brand-muted px-1">
          {upcomingEvents.length} Termine angezeigt
        </div>

        <div class="space-y-3" id="eventsList">
          {upcomingEvents.length > 0 ? (
            upcomingEvents.map((e) => {
              const timing = getEventDisplayDetails(e, todayStart);
              const isInitiallyVisible = true;
              return (
                <div 
                  class={`event-card bg-white border border-brand-border/70 rounded-brand p-5 shadow-sm hover:shadow-md transition-all duration-200 ${isInitiallyVisible ? 'flex' : 'hidden'} flex-col md:flex-row md:items-center justify-between gap-4`}
                  data-category={e.category}
                  data-summary={e.summary.toLowerCase()}
                  data-description={e.description.toLowerCase()}
                  data-location={e.location.toLowerCase()}
                >
                  {/* Date & Time Column */}
                  <div class="flex items-center gap-4 min-w-[210px] md:min-w-[240px] border-b md:border-b-0 md:border-r border-brand-border/40 pb-3 md:pb-0 md:pr-4">
                    <div class="w-14 sm:w-16 h-14 rounded-xl bg-brand-dark text-white flex flex-col items-center justify-center shrink-0 font-extrabold shadow-sm px-1 text-center select-none">
                      <span class="text-[10px] sm:text-xs uppercase leading-none tracking-wider text-slate-300 font-bold">{timing.badgeMonth}</span>
                      <span class={`font-black leading-tight mt-0.5 ${timing.badgeDay.length > 4 ? 'text-[11px] sm:text-xs tracking-tighter' : timing.badgeDay.length > 2 ? 'text-xs sm:text-sm tracking-tighter' : 'text-base sm:text-lg'}`}>
                        {timing.badgeDay}
                      </span>
                    </div>
                    <div class="space-y-0.5">
                      <span class="font-extrabold text-sm text-brand-dark block">
                        {timing.dateRangeStr}
                      </span>
                      <span class="text-xs text-brand-muted flex items-center gap-1 font-medium">
                        <Clock class="w-3.5 h-3.5 text-brand-steel shrink-0" /> {timing.timeStr}
                      </span>
                    </div>
                  </div>

                  {/* Event Details */}
                  <div class="space-y-1.5 flex-grow">
                    <div class="flex flex-wrap items-center gap-2">
                      <span class={`text-xs font-bold px-2.5 py-0.5 rounded-full ${
                        e.category === 'Vorstandssitzung' ? 'bg-blue-100 text-blue-800' :
                        (e.category === 'Meisterschaft' || e.category === 'Vereinsmeisterschaft') ? 'bg-amber-100 text-amber-800' :
                        e.category === 'Arbeitseinsatz' ? 'bg-emerald-100 text-emerald-800' :
                        'bg-slate-100 text-slate-700'
                      }`}>
                        {e.category}
                      </span>

                      {timing.isMultiDay && (
                        <span class="inline-flex items-center gap-1 text-xs font-bold px-2.5 py-0.5 rounded-full bg-indigo-50 text-indigo-700 border border-indigo-200/60">
                          <CalendarRange class="w-3 h-3 text-indigo-500" />
                          {timing.durationDays} Tage
                        </span>
                      )}

                      {timing.isCurrentlyRunning && (
                        <span class="inline-flex items-center gap-1.5 text-xs font-extrabold px-2.5 py-0.5 rounded-full bg-emerald-500 text-white shadow-xs animate-pulse">
                          <span class="w-1.5 h-1.5 rounded-full bg-white"></span>
                          Findet heute statt (Tag {timing.currentDayNumber} von {timing.durationDays})
                        </span>
                      )}
                    </div>
                    <h3 class="text-base font-extrabold text-brand-dark">
                      {e.summary}
                    </h3>
                    {e.location && (
                      <p class="text-xs text-brand-steel flex items-center gap-1">
                        <MapPin class="w-3 h-3 shrink-0 text-brand-steel" /> {e.location}
                      </p>
                    )}
                    {e.description && (
                      <p class="text-xs text-brand-content/80 leading-relaxed pt-1">
                        {e.description}
                      </p>
                    )}
                  </div>
                </div>
              );
            })
          ) : (
            <div class="p-8 text-center bg-white rounded-brand border border-brand-border/70 text-brand-muted">
              Aktuell sind keine weiteren zukünftigen Termine im Kalender eingetragen.
            </div>
          )}
        </div>

        {/* No events message */}
        <div id="noEventsMessage" class="hidden p-8 text-center bg-white rounded-brand border border-brand-border/70 text-brand-muted">
          Keine anstehenden Termine für die gewählte Filterung gefunden.
        </div>
      </div>

      {/* Embedded Google Calendar Card */}
      <div class="bg-white rounded-brand-lg border border-brand-border/80 shadow-md overflow-hidden mt-16">
        <div class="bg-slate-50 border-b border-brand-border/60 p-4 sm:p-6 flex items-center justify-between">
          <div>
            <h2 class="text-xl font-black text-brand-dark flex items-center gap-2">
              <CalendarIcon class="w-5 h-5 text-brand-steel" /> Google Kalender Übersicht
            </h2>
            <p class="text-xs text-brand-muted">Interaktiver Kalender der SG Gersfeld</p>
          </div>
        </div>
        <div class="p-2 sm:p-6 bg-slate-100/50">
          <div class="relative w-full rounded-brand border border-slate-200 overflow-hidden bg-white shadow-inner" style="min-height: 650px;">
            <iframe 
              src={CALENDAR_EMBED_URL}
              style="border: 0; width: 100%; height: 700px;" 
              frameborder="0" 
              scrolling="no"
              title="Google Kalender SG Gersfeld"
              loading="lazy"
            ></iframe>
          </div>
        </div>
      </div>

    </div>

  </div>

  <script is:inline>
    let activeCategory = 'all';

    // Parse URL parameter or hash (e.g. /termine/?filter=Meisterschaft)
    const urlParams = new URLSearchParams(window.location.search);
    const filterParam = urlParams.get('filter') || window.location.hash.replace('#', '');
    if (filterParam && ['all', 'Allgemein', 'Vorstandssitzung', 'Meisterschaft', 'Vereinsmeisterschaft', 'Arbeitseinsatz'].includes(filterParam)) {
      activeCategory = (filterParam === 'Vereinsmeisterschaft') ? 'Meisterschaft' : filterParam;
    }

    function setFilter(cat) {
      activeCategory = cat;
      document.querySelectorAll('.filter-btn').forEach(btn => {
        btn.classList.remove('bg-brand-dark', 'text-white', 'shadow-sm');
        btn.classList.add('bg-slate-100', 'text-brand-steel');
      });
      const activeBtn = document.getElementById(`btn-${cat}`);
      if (activeBtn) {
        activeBtn.classList.remove('bg-slate-100', 'text-brand-steel');
        activeBtn.classList.add('bg-brand-dark', 'text-white', 'shadow-sm');
      }
      applyFilters();
    }

    window.addEventListener('DOMContentLoaded', () => {
      setFilter(activeCategory);
      syncLiveCalendar();
    });
    setFilter(activeCategory);

    function handleSearch() {
      applyFilters();
    }

    function applyFilters() {
      const searchVal = (document.getElementById('eventSearch')?.value || '').toLowerCase().trim();
      const cards = document.querySelectorAll('.event-card');
      let visibleCount = 0;

      cards.forEach(card => {
        const cat = card.getAttribute('data-category');
        const summary = card.getAttribute('data-summary') || '';
        const description = card.getAttribute('data-description') || '';
        const location = card.getAttribute('data-location') || '';

        let matchesCat = false;
        if (activeCategory === 'all') {
          matchesCat = true;
        } else if (activeCategory === 'Allgemein') {
          matchesCat = (cat === 'Allgemein');
        } else if (activeCategory === 'Vorstandssitzung') {
          matchesCat = summary.includes('vorstandssitzung') || cat === 'Vorstandssitzung';
        } else if (activeCategory === 'Meisterschaft' || activeCategory === 'Vereinsmeisterschaft') {
          matchesCat = (/\b(vm|bm|lm)\b|meisterschaft/i.test(summary)) || cat === 'Meisterschaft' || cat === 'Vereinsmeisterschaft';
        } else if (activeCategory === 'Arbeitseinsatz') {
          matchesCat = summary.includes('arbeitseinsatz') || cat === 'Arbeitseinsatz';
        }

        let matchesSearch = true;
        if (searchVal) {
          matchesSearch = summary.includes(searchVal) || description.includes(searchVal) || location.includes(searchVal);
        }

        if (matchesCat && matchesSearch) {
          card.classList.remove('hidden');
          card.classList.add('flex');
          visibleCount++;
        } else {
          card.classList.remove('flex');
          card.classList.add('hidden');
        }
      });

      const counter = document.getElementById('eventsCounter');
      if (counter) {
        counter.textContent = `${visibleCount} Termine angezeigt`;
      }

      const noMsg = document.getElementById('noEventsMessage');
      if (noMsg) {
        if (visibleCount === 0) {
          noMsg.classList.remove('hidden');
        } else {
          noMsg.classList.add('hidden');
        }
      }
    }

    // Live calendar background updater
    async function syncLiveCalendar() {
      try {
        const res = await fetch('/api/calendar.php');
        if (!res.ok) return;
        const data = await res.json();
        if (!data || !data.events || data.events.length === 0) return;

        const months = ['Jan.', 'Feb.', 'März', 'Apr.', 'Mai', 'Juni', 'Juli', 'Aug.', 'Sept.', 'Okt.', 'Nov.', 'Dez.'];
        const days = ['So.', 'Mo.', 'Di.', 'Mi.', 'Do.', 'Fr.', 'Sa.'];

        const todayMidnight = new Date();
        todayMidnight.setHours(0, 0, 0, 0);
        const todayStartMs = todayMidnight.getTime();

        const formatSingleDate = (d) => {
          const days = ['So.', 'Mo.', 'Di.', 'Mi.', 'Do.', 'Fr.', 'Sa.'];
          return `${days[d.getDay()]}, ${String(d.getDate()).padStart(2, '0')}.${String(d.getMonth() + 1).padStart(2, '0')}.${d.getFullYear()}`;
        };

        const formatTimeOnly = (d) => `${String(d.getHours()).padStart(2, '0')}:${String(d.getMinutes()).padStart(2, '0')} Uhr`;
        const monthsShort = ['JAN', 'FEB', 'MÄRZ', 'APR', 'MAI', 'JUNI', 'JULI', 'AUG', 'SEPT', 'OKT', 'NOV', 'DEZ'];

        const upcoming = data.events.map(e => {
          const start = new Date(e.startTime * 1000);
          const end = e.endTime ? new Date(e.endTime * 1000) : null;
          let inclusiveEnd = end ? new Date(end.getTime()) : new Date(start.getTime());
          let durationDays = 1;
          let isMultiDay = false;

          if (e.isAllDay) {
            if (end) {
              const diffMs = end.getTime() - start.getTime();
              const rawDays = Math.round(diffMs / (1000 * 60 * 60 * 24));
              if (rawDays > 1) {
                durationDays = rawDays;
                isMultiDay = true;
                inclusiveEnd = new Date(end.getTime() - 12 * 60 * 60 * 1000);
              }
            }
          } else if (end) {
            const startMid = new Date(start.getFullYear(), start.getMonth(), start.getDate()).getTime();
            const endMid = new Date(end.getFullYear(), end.getMonth(), end.getDate()).getTime();
            const dayDiff = Math.round((endMid - startMid) / (1000 * 60 * 60 * 24)) + 1;
            if (dayDiff > 1) {
              durationDays = dayDiff;
              isMultiDay = true;
              inclusiveEnd = end;
            }
          }

          const startMonthStr = monthsShort[start.getMonth()];
          const endMonthStr = monthsShort[inclusiveEnd.getMonth()];
          let badgeMonth = startMonthStr;
          let badgeDay = String(start.getDate());

          if (isMultiDay) {
            const pad = (n) => String(n).padStart(2, '0');
            if (durationDays > 7) {
              badgeMonth = start.getMonth() === inclusiveEnd.getMonth() ? startMonthStr : `${startMonthStr}/${endMonthStr}`;
              badgeDay = `${start.getDate()}.+`;
            } else if (start.getMonth() === inclusiveEnd.getMonth()) {
              badgeDay = `${pad(start.getDate())}–${pad(inclusiveEnd.getDate())}`;
            } else {
              badgeMonth = `${startMonthStr}/${endMonthStr}`;
              badgeDay = `${pad(start.getDate())}.–${pad(inclusiveEnd.getDate())}.`;
            }
          }

          let dateRangeStr = formatSingleDate(start);
          if (isMultiDay) {
            dateRangeStr = `${formatSingleDate(start)} – ${formatSingleDate(inclusiveEnd)}`;
          }

          let timeStr = '';
          if (e.isAllDay) {
            timeStr = isMultiDay ? `Ganztägig · ${durationDays} Tage` : 'Ganztägig';
          } else {
            if (isMultiDay) {
              const days = ['So.', 'Mo.', 'Di.', 'Mi.', 'Do.', 'Fr.', 'Sa.'];
              timeStr = `${days[start.getDay()]}, ${formatTimeOnly(start)} – ${days[inclusiveEnd.getDay()]}, ${formatTimeOnly(inclusiveEnd)}`;
            } else if (end && end.getTime() > start.getTime()) {
              timeStr = `${formatTimeOnly(start)} – ${formatTimeOnly(end)}`;
            } else {
              timeStr = formatTimeOnly(start);
            }
          }

          const startDayTime = new Date(start.getFullYear(), start.getMonth(), start.getDate()).getTime();
          const endDayTime = new Date(inclusiveEnd.getFullYear(), inclusiveEnd.getMonth(), inclusiveEnd.getDate()).getTime();
          const isCurrentlyRunning = (startDayTime <= todayStartMs && endDayTime >= todayStartMs && isMultiDay);
          let currentDayNumber = undefined;
          if (isCurrentlyRunning) {
            const elapsedDays = Math.round((todayStartMs - startDayTime) / (1000 * 60 * 60 * 24)) + 1;
            currentDayNumber = Math.min(Math.max(elapsedDays, 1), durationDays);
          }

          return {
            ...e,
            start,
            inclusiveEnd,
            isMultiDay,
            durationDays,
            badgeMonth,
            badgeDay,
            dateRangeStr,
            timeStr,
            isCurrentlyRunning,
            currentDayNumber
          };
        });

        const list = document.getElementById('eventsList');
        if (!list) return;

        const html = upcoming.map(e => {
          let badgeCls = 'bg-slate-100 text-slate-700';
          if (e.category === 'Vorstandssitzung') badgeCls = 'bg-blue-100 text-blue-800';
          else if (e.category === 'Meisterschaft' || e.category === 'Vereinsmeisterschaft') badgeCls = 'bg-amber-100 text-amber-800';
          else if (e.category === 'Arbeitseinsatz') badgeCls = 'bg-emerald-100 text-emerald-800';

          const dayFontCls = e.badgeDay.length > 4 ? 'text-[11px] sm:text-xs tracking-tighter' : e.badgeDay.length > 2 ? 'text-xs sm:text-sm tracking-tighter' : 'text-base sm:text-lg';

          const multiDayBadge = e.isMultiDay ? `
            <span class="inline-flex items-center gap-1 text-xs font-bold px-2.5 py-0.5 rounded-full bg-indigo-50 text-indigo-700 border border-indigo-200/60">
              <svg class="w-3 h-3 text-indigo-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M16 2v4"/><path d="M3 10h18"/><path d="M8 2v4"/><path d="M17 14h-6"/><path d="M13 18H7"/><path d="M7 14h.01"/><path d="M17 18h.01"/></svg>
              ${e.durationDays} Tage
            </span>
          ` : '';

          const runningBadge = e.isCurrentlyRunning ? `
            <span class="inline-flex items-center gap-1.5 text-xs font-extrabold px-2.5 py-0.5 rounded-full bg-emerald-500 text-white shadow-xs animate-pulse">
              <span class="w-1.5 h-1.5 rounded-full bg-white"></span>
              Findet heute statt (Tag ${e.currentDayNumber} von ${e.durationDays})
            </span>
          ` : '';

          return `
            <div 
              class="event-card bg-white border border-brand-border/70 rounded-brand p-5 shadow-sm hover:shadow-md transition-all duration-200 flex flex-col md:flex-row md:items-center justify-between gap-4"
              data-category="${e.category}"
              data-summary="${e.summary.toLowerCase()}"
              data-description="${(e.description || '').toLowerCase()}"
              data-location="${(e.location || '').toLowerCase()}"
            >
              <div class="flex items-center gap-4 min-w-[210px] md:min-w-[240px] border-b md:border-b-0 md:border-r border-brand-border/40 pb-3 md:pb-0 md:pr-4">
                <div class="w-14 sm:w-16 h-14 rounded-xl bg-brand-dark text-white flex flex-col items-center justify-center shrink-0 font-extrabold shadow-sm px-1 text-center select-none">
                  <span class="text-[10px] sm:text-xs uppercase leading-none tracking-wider text-slate-300 font-bold">${e.badgeMonth}</span>
                  <span class="font-black leading-tight mt-0.5 ${dayFontCls}">${e.badgeDay}</span>
                </div>
                <div class="space-y-0.5">
                  <span class="font-extrabold text-sm text-brand-dark block">${e.dateRangeStr}</span>
                  <span class="text-xs text-brand-muted flex items-center gap-1 font-medium">
                    <svg class="w-3.5 h-3.5 text-brand-steel shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                    ${e.timeStr}
                  </span>
                </div>
              </div>
              <div class="space-y-1.5 flex-grow">
                <div class="flex flex-wrap items-center gap-2">
                  <span class="text-xs font-bold px-2.5 py-0.5 rounded-full ${badgeCls}">${e.category}</span>
                  ${multiDayBadge}
                  ${runningBadge}
                </div>
                <h3 class="text-base font-extrabold text-brand-dark">${e.summary}</h3>
                ${e.location ? `<p class="text-xs text-brand-steel flex items-center gap-1"><svg class="w-3 h-3 shrink-0 text-brand-steel" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg> ${e.location}</p>` : ''}
                ${e.description ? `<p class="text-xs text-brand-content/80 leading-relaxed pt-1">${e.description}</p>` : ''}
              </div>
            </div>
          `;
        }).join('');

        list.innerHTML = html;

        // Update counts on filter buttons
        const allCnt = upcoming.length;
        const allgCnt = upcoming.filter(e => e.category === 'Allgemein').length;
        const vorstCnt = upcoming.filter(e => e.summary.toLowerCase().includes('vorstandssitzung') || e.category === 'Vorstandssitzung').length;
        const meisterschaftCnt = upcoming.filter(e => /\b(vm|bm|lm)\b|meisterschaft/i.test(e.summary) || e.category === 'Meisterschaft' || e.category === 'Vereinsmeisterschaft').length;
        const arbCnt = upcoming.filter(e => e.summary.toLowerCase().includes('arbeitseinsatz') || e.category === 'Arbeitseinsatz').length;

        const bAllg = document.getElementById('btn-Allgemein');
        if (bAllg) bAllg.textContent = `🎯 Allgemein (${allgCnt})`;
        const bAll = document.getElementById('btn-all');
        if (bAll) bAll.textContent = `Alle (${allCnt})`;
        const bVorst = document.getElementById('btn-Vorstandssitzung');
        if (bVorst) bVorst.textContent = `👥 Vorstandssitzungen (${vorstCnt})`;
        const bMeisterschaft = document.getElementById('btn-Meisterschaft') || document.getElementById('btn-Vereinsmeisterschaft');
        if (bMeisterschaft) bMeisterschaft.textContent = `🏆 Meisterschaften (${meisterschaftCnt})`;
        const bArb = document.getElementById('btn-Arbeitseinsatz');
        if (bArb) bArb.textContent = `🔨 Arbeitseinsätze (${arbCnt})`;

        applyFilters();
      } catch (err) {
        console.warn('Live calendar sync fallback to pre-rendered:', err);
      }
    }
  </script>

</Layout>

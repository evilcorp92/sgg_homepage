---
import Layout from '../../layouts/Layout.astro';
import { getCalendarEvents } from '../../data/calendar';
import { 
  Calendar as CalendarIcon, Trophy, Hammer, ShieldCheck, ExternalLink, Download, Clock, MapPin 
} from 'lucide-react';

const allEvents = await getCalendarEvents();
const now = new Date();
const todayStart = new Date(now.getFullYear(), now.getMonth(), now.getDate()).getTime();

const allgemeinEvents = allEvents
  .filter(e => e.category === 'Allgemein' && e.startDate.getTime() >= todayStart)
  .sort((a, b) => a.startDate.getTime() - b.startDate.getTime());

const formatDate = (date: Date) => {
  return date.toLocaleDateString('de-DE', { weekday: 'short', day: '2-digit', month: '2-digit', year: 'numeric' });
};

const formatTime = (date: Date, isAllDay: boolean) => {
  if (isAllDay) return 'Ganztägig';
  return date.toLocaleTimeString('de-DE', { hour: '2-digit', minute: '2-digit' }) + ' Uhr';
};
---

<Layout title="Termine - Allgemein - SG Gersfeld 1813 e.V." description="Anstehende allgemeine Termine aus dem Google Kalender der SG Gersfeld: Feste, Meisterschaften und Veranstaltungen.">
  
  <div class="bg-brand-card min-h-screen pb-24">
    
    {/* Page Header */}
    <header class="bg-brand-bg py-20 border-b border-brand-border/40 px-6 text-center">
      <div class="max-w-3xl mx-auto space-y-4">
        <span class="text-xs font-extrabold tracking-widest uppercase text-brand-steel">
          Vereinstermine
        </span>
        <h1 class="text-3xl sm:text-4xl font-extrabold text-brand-dark tracking-tight flex items-center justify-center gap-3">
          <Trophy class="w-8 h-8 text-brand-steel" /> Anstehende allgemeine Vereinstermine
        </h1>
        <p class="text-brand-muted font-medium max-w-2xl mx-auto">
          Alle kommenden allgemeinen Termine, Turniere, Feste und Meisterschaften live aus dem Google Kalender.
        </p>
      </div>
    </header>

    <div class="max-w-5xl mx-auto px-6 mt-12 space-y-10">

      {/* Navigation Filter Tabs */}
      <div class="flex flex-wrap items-center justify-center gap-3">
        <a 
          href="/termine/" 
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-white hover:bg-slate-100 text-brand-steel hover:text-brand-dark text-sm font-bold border border-brand-border/80 transition-colors shadow-sm"
        >
          <CalendarIcon class="w-4 h-4" /> Alle Termine
        </a>
        <a 
          href="/termine/allgemein/" 
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-brand-dark text-white text-sm font-bold shadow-sm"
        >
          <Trophy class="w-4 h-4" /> Allgemein ({allgemeinEvents.length})
        </a>
        <a 
          href="/termine/arbeitseinsaetze/" 
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-white hover:bg-slate-100 text-brand-steel hover:text-brand-dark text-sm font-bold border border-brand-border/80 transition-colors shadow-sm"
        >
          <Hammer class="w-4 h-4" /> Arbeitseinsätze
        </a>
        <a 
          href="https://dp.sg-gersfeld.de/" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-white hover:bg-slate-100 text-brand-steel hover:text-brand-dark text-sm font-bold border border-brand-border/80 transition-colors shadow-sm"
        >
          <ShieldCheck class="w-4 h-4" /> Dienstplan <ExternalLink class="w-3.5 h-3.5 opacity-60" />
        </a>
      </div>

      {/* Real Events List */}
      <div class="space-y-3">
        <div class="text-xs font-bold text-brand-muted px-1">
          {allgemeinEvents.length} anstehende Termine
        </div>

        {allgemeinEvents.length > 0 ? (
          allgemeinEvents.map((e) => (
            <div class="bg-white border border-brand-border/70 rounded-brand p-5 shadow-sm hover:shadow-md transition-all duration-200 flex flex-col md:flex-row md:items-center justify-between gap-4">
              <div class="flex items-center gap-4 min-w-[200px] border-b md:border-b-0 md:border-r border-brand-border/40 pb-3 md:pb-0 md:pr-4">
                <div class="w-12 h-12 rounded-xl bg-brand-dark text-white flex flex-col items-center justify-center shrink-0 font-extrabold shadow-sm">
                  <span class="text-xs uppercase leading-none">{e.startDate.toLocaleDateString('de-DE', { month: 'short' })}</span>
                  <span class="text-base leading-tight">{e.startDate.getDate()}</span>
                </div>
                <div class="space-y-0.5">
                  <span class="font-extrabold text-sm text-brand-dark block">
                    {formatDate(e.startDate)}
                  </span>
                  <span class="text-xs text-brand-muted flex items-center gap-1 font-medium">
                    <Clock class="w-3 h-3 text-brand-steel" /> {formatTime(e.startDate, e.isAllDay)}
                  </span>
                </div>
              </div>

              <div class="space-y-1 flex-grow">
                <div class="flex items-center gap-2">
                  <span class="text-xs font-bold px-2.5 py-0.5 rounded-full bg-slate-100 text-slate-700">
                    Allgemein
                  </span>
                </div>
                <h3 class="text-base font-extrabold text-brand-dark">
                  {e.summary}
                </h3>
                {e.location && (
                  <p class="text-xs text-brand-steel flex items-center gap-1">
                    <MapPin class="w-3 h-3 shrink-0 text-brand-steel" /> {e.location}
                  </p>
                )}
                {e.description && (
                  <p class="text-xs text-brand-content/80 leading-relaxed pt-1">
                    {e.description}
                  </p>
                )}
              </div>
            </div>
          ))
        ) : (
          <div class="p-8 text-center bg-white rounded-brand border border-brand-border/70 text-brand-muted">
            Aktuell sind keine allgemeinen kommenden Termine eingetragen.
          </div>
        )}
      </div>

    </div>

  </div>

</Layout>

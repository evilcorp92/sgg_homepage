---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { Calendar, ChevronLeft, ArrowLeft, Tag } from 'lucide-react';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map(post => ({
    params: { slug: post.slug.replace(/^.*\//, '') },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();

const extractFeaturedImage = (body: string) => {
  // 1. Markdown image syntax
  const mdMatch = body.match(/!\[.*?\]\((https?:\/\/[^\s\)]+|\/[^\s\)]+)\)/);
  if (mdMatch && mdMatch[1]) return mdMatch[1];
  // 2. HTML image syntax
  const htmlMatch = body.match(/<img[^>]+src=["'](https?:\/\/[^"'>]+|\/[^"'>]+)["']/i);
  if (htmlMatch && htmlMatch[1]) return htmlMatch[1];
  // 3. Fallback to Schützenhaus
  return '/images/schuetzenhaus-gersfeld.jpg';
};

const featuredImage = extractFeaturedImage(post.body);
---

<Layout title={`${post.data.title} - SG Gersfeld`} description={post.body.substring(0, 150)}>
  
  <article class="bg-brand-card min-h-screen pb-24">
    
    <!-- Hero Header Banner with Featured Image Background -->
    <header class="relative min-h-[380px] sm:min-h-[440px] flex items-center justify-center bg-slate-950 text-white overflow-hidden py-20 px-6 text-center">
      <div 
        class="absolute inset-0 bg-cover bg-center bg-no-repeat opacity-40 scale-105 transition-transform duration-700 select-none pointer-events-none" 
        style={`background-image: url('${featuredImage}');`}
      ></div>
      <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/60 to-slate-950/80 pointer-events-none"></div>

      <div class="relative max-w-4xl mx-auto z-10 space-y-5">
        
        <div>
          <a 
            href="/posts/" 
            class="inline-flex items-center gap-1.5 text-xs font-bold text-slate-300 hover:text-white transition-colors bg-white/10 hover:bg-white/20 backdrop-blur-md px-3.5 py-1.5 rounded-full border border-white/10 shadow-sm"
          >
            <ChevronLeft class="w-3.5 h-3.5" /> Zurück zu allen Vereinsnews
          </a>
        </div>

        <div class="flex items-center justify-center gap-2 text-xs sm:text-sm font-bold text-slate-300">
          <Calendar class="w-4 h-4 text-brand-steel" /> 
          <span>{post.data.date.toLocaleDateString('de-DE', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' })}</span>
        </div>

        <h1 class="text-3xl sm:text-4xl md:text-5xl font-black text-white tracking-tight leading-[1.2] max-w-3xl mx-auto text-shadow-md">
          {post.data.title}
        </h1>

        {(() => {
          const validCategories = (post.data.categories || []).filter((cat: string) => cat.toLowerCase() !== 'uncategorized');
          return validCategories.length > 0 ? (
            <div class="flex flex-wrap items-center justify-center gap-2 pt-2">
              {validCategories.map((cat: string) => (
                <span class="px-3 py-1 rounded-full bg-white/15 backdrop-blur-sm text-xs font-extrabold text-slate-200 border border-white/10 uppercase tracking-wider">
                  {cat}
                </span>
              ))}
            </div>
          ) : null;
        })()}

      </div>
    </header>

    <!-- Prose Content Container -->
    <div class="max-w-3xl mx-auto px-6 mt-16 prose">
      <Content />
    </div>

    <!-- Back Navigation Footer -->
    <div class="max-w-3xl mx-auto px-6 mt-16 pt-8 border-t border-brand-border/60 flex items-center justify-between">
      <a 
        href="/posts/" 
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-brand bg-white hover:bg-slate-100 text-brand-steel hover:text-brand-dark border border-brand-border/80 text-xs font-bold transition-all shadow-sm"
      >
        <ArrowLeft class="w-4 h-4" /> Alle Berichte ansehen
      </a>
      <a 
        href="#top" 
        class="text-xs font-bold text-brand-steel hover:text-brand-dark transition-colors"
      >
        Nach oben ↑
      </a>
    </div>

  </article>

</Layout>
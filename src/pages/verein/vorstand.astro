---
import Layout from '../../layouts/Layout.astro';
import { 
  HAUPTVORSTAND, SCHIESSWARTE, KASSENPRUEFER, KOENIGSFAMILIE, BDS_VORSTAND, BDS_KASSENPRUEFER, BDS_ROS 
} from '../../data/vorstand';
import { Mail, Users, ShieldCheck, Crown, Target, Crosshair } from 'lucide-react';
---

<Layout title="Vorstand - SG Gersfeld 1813 e.V.">
  <article class="bg-brand-card min-h-screen pb-24">
    
    <!-- Page Header -->
    <header class="bg-brand-bg py-20 border-b border-brand-border/40 px-6 text-center">
      <div class="max-w-3xl mx-auto space-y-3">
        <h1 class="text-3xl sm:text-4xl font-extrabold text-brand-dark tracking-tight leading-tight">
          Vorstand & Funktionsträger
        </h1>
        <div class="w-12 h-1 bg-brand-steel/30 mx-auto rounded-full"></div>
        <p class="text-brand-steel text-sm sm:text-base max-w-xl mx-auto pt-2">
          Die gewählten Vorstandsmitglieder und Funktionsträger der Schützengesellschaft Gersfeld 1813 e.V.
        </p>
      </div>
    </header>

    <!-- Main Content Container -->
    <div class="max-w-4xl mx-auto px-6 mt-16 space-y-16">
      
      <!-- Section 1: Hauptvorstände SG Gersfeld 1813 e.V. -->
      <section id="geschaeftsfuehrend" class="space-y-6 scroll-mt-24">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-3 border-b border-brand-border">
          <div class="space-y-1">
            <h2 class="text-2xl font-extrabold text-brand-dark flex items-center gap-2">
              <Users class="w-6 h-6 text-brand-steel" /> Hauptvorstand
            </h2>
            <p class="text-sm text-brand-steel/80">
              SG Gersfeld 1813 e.V.
            </p>
          </div>
          <a href="mailto:vorstand@sg-gersfeld.de" class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-lg bg-brand-bg text-xs font-bold text-brand-steel hover:text-brand-dark hover:bg-brand-steel/10 transition-colors self-start sm:self-auto">
            <Mail class="w-4 h-4 text-brand-steel" /> Verteiler: vorstand@sg-gersfeld.de
          </a>
        </div>

        <div class="overflow-x-auto rounded-brand border border-brand-border shadow-sm">
          <table class="w-full text-left text-sm text-brand-steel/90">
            <thead class="bg-brand-dark text-white font-bold text-xs uppercase tracking-wider">
              <tr>
                <th class="px-5 py-3.5">Funktion</th>
                <th class="px-5 py-3.5">Vorname</th>
                <th class="px-5 py-3.5">Nachname</th>
                <th class="px-5 py-3.5">E-Mail</th>
                <th class="px-5 py-3.5 text-center">Status</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-brand-border bg-brand-card">
              {HAUPTVORSTAND.map((member) => (
                <tr class={`hover:bg-brand-bg/60 transition-colors ${member.geschaeftsfuehrend ? 'bg-brand-steel/5' : ''}`}>
                  <td class="px-5 py-3.5 font-bold text-brand-dark">
                    <div class="flex items-center gap-2 flex-wrap">
                      <span>{member.funktion}</span>
                      {member.geschaeftsfuehrend && (
                        <span class="text-[10px] font-extrabold px-1.5 py-0.5 rounded bg-blue-100 text-blue-800 tracking-wide" title="Geschäftsführender Vorstand nach § 26 BGB">
                          geschäftsführend*
                        </span>
                      )}
                    </div>
                  </td>
                  <td class="px-5 py-3.5">{member.vorname}</td>
                  <td class="px-5 py-3.5 font-medium">{member.nachname}</td>
                  <td class="px-5 py-3.5">
                    {member.email ? (
                      <a href={`mailto:${member.email}`} class="font-medium text-brand-steel hover:text-brand-dark flex items-center gap-1">
                        <Mail class="w-3.5 h-3.5 opacity-60" /> {member.email}
                      </a>
                    ) : (
                      <span class="text-slate-400">—</span>
                    )}
                  </td>
                  <td class="px-5 py-3.5 text-center">
                    {member.kommissarisch && (
                      <span class="inline-block text-[10px] uppercase font-bold px-2 py-0.5 rounded bg-amber-100 text-amber-800">
                        kommissarisch
                      </span>
                    )}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <p class="text-xs text-brand-muted leading-relaxed">
          * = <strong>Geschäftsführender Vorstand</strong> (Kontakt: <a href="mailto:gf@sg-gersfeld.de" class="text-brand-steel hover:underline font-semibold">gf@sg-gersfeld.de</a>)
        </p>
      </section>

      <!-- Section 2: Schießwarte -->
      <section class="space-y-6">
        <div class="pb-3 border-b border-brand-border">
          <h2 class="text-2xl font-extrabold text-brand-dark flex items-center gap-2">
            <Target class="w-6 h-6 text-brand-steel" /> Schießwarte
          </h2>
        </div>

        <div class="overflow-x-auto rounded-brand border border-brand-border shadow-sm">
          <table class="w-full text-left text-sm text-brand-steel/90">
            <thead class="bg-brand-dark text-white font-bold text-xs uppercase tracking-wider">
              <tr>
                <th class="px-5 py-3.5">Vorname</th>
                <th class="px-5 py-3.5">Nachname</th>
                <th class="px-5 py-3.5 text-right">Status</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-brand-border bg-brand-card">
              {SCHIESSWARTE.map((wart) => (
                <tr class="hover:bg-brand-bg/60 transition-colors">
                  <td class="px-5 py-3.5">{wart.vorname}</td>
                  <td class="px-5 py-3.5 font-medium text-brand-dark">{wart.nachname}</td>
                  <td class="px-5 py-3.5 text-right">
                    {wart.kommissarisch && (
                      <span class="inline-block text-[10px] uppercase font-bold px-2 py-0.5 rounded bg-amber-100 text-amber-800">
                        kommissarisch
                      </span>
                    )}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <!-- Section 3: Kassenprüfer & Königsfamilie (2 Column Grid) -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        
        <!-- Kassenprüfer -->
        <section class="space-y-4">
          <div class="pb-3 border-b border-brand-border">
            <h2 class="text-xl font-extrabold text-brand-dark flex items-center gap-2">
              <ShieldCheck class="w-5 h-5 text-brand-steel" /> Kassenprüfer
            </h2>
          </div>

          <div class="overflow-hidden rounded-brand border border-brand-border shadow-sm">
            <table class="w-full text-left text-sm text-brand-steel/90">
              <thead class="bg-brand-dark text-white font-bold text-xs uppercase tracking-wider">
                <tr>
                  <th class="px-4 py-3">Funktion</th>
                  <th class="px-4 py-3">Name</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-brand-border bg-brand-card">
                {KASSENPRUEFER.map((kp) => (
                  <tr class="hover:bg-brand-bg/60 transition-colors">
                    <td class="px-4 py-3 font-semibold text-brand-dark">{kp.funktion}</td>
                    <td class="px-4 py-3">{kp.vorname} {kp.nachname}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>

        <!-- Königsfamilie -->
        <section class="space-y-4">
          <div class="pb-3 border-b border-brand-border">
            <h2 class="text-xl font-extrabold text-brand-dark flex items-center gap-2">
              <Crown class="w-5 h-5 text-amber-500" /> Königsfamilie
            </h2>
          </div>

          <div class="overflow-hidden rounded-brand border border-brand-border shadow-sm">
            <table class="w-full text-left text-sm text-brand-steel/90">
              <thead class="bg-brand-dark text-white font-bold text-xs uppercase tracking-wider">
                <tr>
                  <th class="px-4 py-3">Titel</th>
                  <th class="px-4 py-3">Name</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-brand-border bg-brand-card">
                {KOENIGSFAMILIE.map((k) => (
                  <tr class="hover:bg-brand-bg/60 transition-colors">
                    <td class="px-4 py-3 font-bold text-brand-dark flex items-center gap-1.5">
                      <Crown class="w-3.5 h-3.5 text-amber-500" /> {k.titel}
                    </td>
                    <td class="px-4 py-3 font-medium">{k.vorname} {k.nachname}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>

      </div>

      <!-- Section 4: BDS-Schützen SG Gersfeld e.V. -->
      <section class="space-y-8 pt-8 border-t border-brand-border">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-3 border-b border-brand-border">
          <div>
            <h2 class="text-2xl font-extrabold text-brand-dark flex items-center gap-2">
              <Crosshair class="w-6 h-6 text-brand-steel" /> BDS-Schützen SG Gersfeld e.V.
            </h2>
            <p class="text-sm text-brand-steel/80">
              Eigenständige BDS-Gruppe im Verein
            </p>
          </div>
          <a href="mailto:bds@sg-gersfeld.de" class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-lg bg-brand-bg text-xs font-bold text-brand-steel hover:text-brand-dark hover:bg-brand-steel/10 transition-colors self-start sm:self-auto">
            <Mail class="w-4 h-4 text-brand-steel" /> Kontakt: bds@sg-gersfeld.de
          </a>
        </div>

        <!-- BDS Vorstand -->
        <div class="space-y-4">
          <h3 class="text-lg font-extrabold text-brand-dark">
            Vorstand BDS-Gruppe
          </h3>

          <div class="overflow-x-auto rounded-brand border border-brand-border shadow-sm">
            <table class="w-full text-left text-sm text-brand-steel/90">
              <thead class="bg-brand-dark text-white font-bold text-xs uppercase tracking-wider">
                <tr>
                  <th class="px-5 py-3.5">Funktion</th>
                  <th class="px-5 py-3.5">Vorname</th>
                  <th class="px-5 py-3.5">Nachname</th>
                  <th class="px-5 py-3.5">E-Mail</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-brand-border bg-brand-card">
                {BDS_VORSTAND.map((member) => (
                  <tr class="hover:bg-brand-bg/60 transition-colors">
                    <td class="px-5 py-3.5 font-bold text-brand-dark">{member.funktion}</td>
                    <td class="px-5 py-3.5">{member.vorname}</td>
                    <td class="px-5 py-3.5 font-medium">{member.nachname}</td>
                    <td class="px-5 py-3.5">
                      {member.email ? (
                        <a href={`mailto:${member.email}`} class="font-medium text-brand-steel hover:text-brand-dark flex items-center gap-1">
                          <Mail class="w-3.5 h-3.5 opacity-60" /> {member.email}
                        </a>
                      ) : (
                        <span class="text-slate-400">—</span>
                      )}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>

        <!-- BDS Kassenprüfer -->
        <div class="space-y-4">
          <h3 class="text-lg font-extrabold text-brand-dark flex items-center gap-2">
            <ShieldCheck class="w-5 h-5 text-brand-steel" /> Kassenprüfer BDS-Gruppe
          </h3>

          <div class="overflow-x-auto rounded-brand border border-brand-border shadow-sm max-w-md">
            <table class="w-full text-left text-sm text-brand-steel/90">
              <thead class="bg-brand-dark text-white font-bold text-xs uppercase tracking-wider">
                <tr>
                  <th class="px-5 py-3.5">Funktion</th>
                  <th class="px-5 py-3.5">Name</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-brand-border bg-brand-card">
                {BDS_KASSENPRUEFER.map((kp) => (
                  <tr class="hover:bg-brand-bg/60 transition-colors">
                    <td class="px-5 py-3.5 font-semibold text-brand-dark">{kp.funktion}</td>
                    <td class="px-5 py-3.5">{kp.vorname} {kp.nachname}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>

        <!-- BDS ROs -->
        <div class="space-y-4">
          <h3 class="text-lg font-extrabold text-brand-dark">
            ROs (Range Officers)
          </h3>

          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
            {BDS_ROS.map((ro) => (
              <div class="p-3 rounded-lg border border-brand-border bg-brand-bg/50 text-sm font-semibold text-brand-dark flex items-center gap-2">
                <ShieldCheck class="w-4 h-4 text-brand-steel" />
                <span>{ro.vorname} {ro.nachname}</span>
              </div>
            ))}
          </div>
        </div>

      </section>

    </div>
  </article>
</Layout>

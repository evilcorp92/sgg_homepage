---
import Layout from '../../layouts/Layout.astro';
import { 
  UserPlus, CheckCircle2, Download, ExternalLink, Mail, AlertTriangle, FileText, ArrowRight, Shield, CreditCard, BookOpen 
} from 'lucide-react';
---

<Layout title="Mitglied werden - SG Gersfeld 1813 e.V." description="Werde Mitglied in der Schützengesellschaft Gersfeld 1813 e.V. und der BDS-Abteilung: Aufnahmeantrag, Online-Formular und Voraussetzungen.">
  
  <div class="bg-brand-card min-h-screen pb-24">
    
    {/* Page Header */}
    <header class="bg-brand-bg py-20 border-b border-brand-border/40 px-6 text-center">
      <div class="max-w-3xl mx-auto space-y-4">
        <span class="text-xs font-extrabold tracking-widest uppercase text-brand-steel">
          Vereinsbeitritt & Aufnahme
        </span>
        <h1 class="text-3xl sm:text-4xl font-extrabold text-brand-dark tracking-tight flex items-center justify-center gap-3">
          <UserPlus class="w-8 h-8 text-brand-steel" /> Mitglied werden
        </h1>
        <p class="text-brand-muted font-medium max-w-2xl mx-auto">
          Du möchtest Teil unserer Schützengemeinschaft werden? Hier findest du alle Informationen, Formulare und Schritte zur Aufnahme in die SG Gersfeld 1813 e.V. und die BDS-Gruppe.
        </p>
      </div>
    </header>

    <div class="max-w-5xl mx-auto px-6 mt-12 space-y-12">

      {/* Aufnahmestopp / Bewerber Hinweis */}
      <div class="bg-amber-50 border border-amber-200 rounded-brand-lg p-6 sm:p-8 flex flex-col sm:flex-row items-start sm:items-center gap-5 shadow-sm">
        <div class="w-12 h-12 rounded-xl bg-amber-100 text-amber-700 flex items-center justify-center shrink-0">
          <AlertTriangle class="w-6 h-6" />
        </div>
        <div class="space-y-1 flex-grow">
          <h2 class="text-lg font-extrabold text-amber-900">
            Hinweis zur Bewerbung um Mitgliedschaft
          </h2>
          <p class="text-xs sm:text-sm text-amber-800 leading-relaxed">
            Aufgrund der hohen Nachfrage und zur Gewährleistung bester Trainingsbedingungen gilt bei uns das Prinzip <em>„Qualität vor Quantität“</em>. Bewerbungen werden sorgfältig vom Vorstand geprüft.
          </p>
        </div>
        <a 
          href="/posts/aufnahmestopp-fuer-bewerber-qualitaet-vor-quantitaet/" 
          class="shrink-0 inline-flex items-center gap-1.5 px-4 py-2 rounded-brand bg-amber-600 hover:bg-amber-700 text-white font-bold text-xs transition-colors shadow-sm"
        >
          Details lesen <ArrowRight class="w-3.5 h-3.5" />
        </a>
      </div>

      {/* Schritt-für-Schritt Hauptverein SG Gersfeld */}
      <div class="bg-white rounded-brand-lg border border-brand-border/70 p-6 sm:p-8 shadow-sm space-y-8">
        <div class="flex items-center justify-between border-b border-brand-border/40 pb-4">
          <div>
            <h2 class="text-2xl font-black text-brand-dark">
              1. Aufnahme in die SG Gersfeld 1813 e.V.
            </h2>
            <p class="text-xs text-brand-muted">Hauptverein (DSB, Tradition & allgemeiner Schießbetrieb)</p>
          </div>
          <span class="text-xs font-extrabold px-3 py-1 rounded-full bg-slate-100 text-brand-dark border border-slate-200">
            Schritt 1
          </span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          
          <div class="p-5 rounded-brand bg-slate-50 border border-slate-200/80 space-y-3 flex flex-col justify-between">
            <div class="space-y-2">
              <span class="w-8 h-8 rounded-full bg-brand-dark text-white text-xs font-black flex items-center justify-center">1</span>
              <h3 class="font-bold text-brand-dark text-base">Antrag ausfüllen</h3>
              <p class="text-xs text-brand-steel leading-relaxed">
                Fülle den Aufnahmeantrag entweder bequem digital online aus oder lade das PDF herunter.
              </p>
            </div>
            <div class="pt-2 space-y-2">
              <a 
                href="https://easyverein.com/public/SGGersfeld/applicationform/9583" 
                target="_blank" 
                rel="noopener noreferrer"
                class="w-full inline-flex items-center justify-center gap-1.5 bg-brand-dark hover:bg-brand-steel text-white text-xs font-bold py-2.5 rounded-brand transition-colors shadow-sm"
              >
                Online-Antrag (easyVerein) <ExternalLink class="w-3.5 h-3.5" />
              </a>
              <a 
                href="https://www.sg-gersfeld.de/wp-content/uploads/2022/02/Aufnahmeantrag.pdf" 
                target="_blank" 
                rel="noopener noreferrer"
                class="w-full inline-flex items-center justify-center gap-1.5 bg-white hover:bg-slate-100 text-brand-steel border border-slate-300 text-xs font-bold py-2 rounded-brand transition-colors"
              >
                <Download class="w-3.5 h-3.5" /> Aufnahmeantrag (PDF)
              </a>
            </div>
          </div>

          <div class="p-5 rounded-brand bg-slate-50 border border-slate-200/80 space-y-3 flex flex-col justify-between">
            <div class="space-y-2">
              <span class="w-8 h-8 rounded-full bg-brand-dark text-white text-xs font-black flex items-center justify-center">2</span>
              <h3 class="font-bold text-brand-dark text-base">Antrag einreichen</h3>
              <p class="text-xs text-brand-steel leading-relaxed">
                Sende den ausgefüllten und unterschriebenen Antrag per E-Mail oder Post an unsere Mitgliederverwaltung.
              </p>
            </div>
            <div class="pt-2">
              <a 
                href="mailto:mitgliederverwaltung@sg-gersfeld.de" 
                class="w-full inline-flex items-center justify-center gap-1.5 bg-white hover:bg-slate-100 text-brand-steel border border-slate-300 text-xs font-bold py-2 rounded-brand transition-colors"
              >
                <Mail class="w-3.5 h-3.5" /> mitgliederverwaltung@sg-gersfeld.de
              </a>
            </div>
          </div>

          <div class="p-5 rounded-brand bg-slate-50 border border-slate-200/80 space-y-3 flex flex-col justify-between">
            <div class="space-y-2">
              <span class="w-8 h-8 rounded-full bg-brand-dark text-white text-xs font-black flex items-center justify-center">3</span>
              <h3 class="font-bold text-brand-dark text-base">Persönliche Vorstellung</h3>
              <p class="text-xs text-brand-steel leading-relaxed">
                Persönliche Vorstellung bei der nächsten Vorstandssitzung (bitte 2 Passfotos für die Schießklappe mitbringen).
              </p>
            </div>
            <div class="pt-2">
              <a 
                href="/termine/?filter=Vorstandssitzung" 
                class="w-full inline-flex items-center justify-center gap-1.5 bg-white hover:bg-slate-100 text-brand-steel border border-slate-300 text-xs font-bold py-2 rounded-brand transition-colors"
              >
                Vorstandssitzungen ansehen →
              </a>
            </div>
          </div>

        </div>

        {/* Quick Links Row */}
        <div class="pt-4 border-t border-brand-border/40 flex flex-wrap items-center justify-between gap-4 text-xs font-bold text-brand-steel">
          <div class="flex items-center gap-6">
            <a href="/verein/kosten/" class="hover:text-brand-dark flex items-center gap-1.5">
              <CreditCard class="w-4 h-4 text-brand-steel" /> Übersicht der Mitgliedsbeiträge →
            </a>
            <a href="/verein/satzung/" class="hover:text-brand-dark flex items-center gap-1.5">
              <BookOpen class="w-4 h-4 text-brand-steel" /> Vereinssatzung einsehen →
            </a>
          </div>
        </div>
      </div>

      {/* BDS-Abteilung Aufnahme */}
      <div class="bg-white rounded-brand-lg border border-brand-border/70 p-6 sm:p-8 shadow-sm space-y-6">
        <div class="flex items-center justify-between border-b border-brand-border/40 pb-4">
          <div>
            <h2 class="text-2xl font-black text-brand-dark">
              2. Zusatzaufnahme in die BDS-Abteilung
            </h2>
            <p class="text-xs text-brand-muted">BDS-Schützen SG Gersfeld e.V. (Großkaliber, Speed, Mehrdistanz & IPSC)</p>
          </div>
          <span class="text-xs font-extrabold px-3 py-1 rounded-full bg-slate-100 text-brand-dark border border-slate-200">
            BDS Sparte
          </span>
        </div>

        <p class="text-sm text-brand-content leading-relaxed">
          Wer zusätzlich in unserer Großkaliber- und Mehrdistanzsparte des <strong>Bundes Deutscher Sportschützen (BDS)</strong> aktiv sein möchte, füllt bitte zusätzlich folgende Formulare aus:
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <a 
            href="https://www.sg-gersfeld.de/wp-content/uploads/2020/06/AufnahmeantragSGG-BDS.pdf" 
            target="_blank" 
            rel="noopener noreferrer"
            class="p-4 rounded-brand bg-brand-bg/60 hover:bg-brand-bg border border-brand-border/60 hover:border-brand-steel/40 flex items-center justify-between transition-all group"
          >
            <div class="flex items-center gap-3">
              <FileText class="w-5 h-5 text-brand-steel" />
              <div>
                <span class="font-bold text-brand-dark text-sm block group-hover:text-brand-steel">Aufnahmeantrag BDS SG Gersfeld</span>
                <span class="text-xs text-brand-muted">PDF Download</span>
              </div>
            </div>
            <Download class="w-4 h-4 text-brand-steel opacity-60" />
          </a>

          <a 
            href="https://bdshessen.de/wp-content/uploads/2026/02/BDS_Aufnahmeantrag.pdf" 
            target="_blank" 
            rel="noopener noreferrer"
            class="p-4 rounded-brand bg-brand-bg/60 hover:bg-brand-bg border border-brand-border/60 hover:border-brand-steel/40 flex items-center justify-between transition-all group"
          >
            <div class="flex items-center gap-3">
              <FileText class="w-5 h-5 text-brand-steel" />
              <div>
                <span class="font-bold text-brand-dark text-sm block group-hover:text-brand-steel">Aufnahmeantrag BDS LV Hessen</span>
                <span class="text-xs text-brand-muted">Offizielles Landesverband-PDF</span>
              </div>
            </div>
            <Download class="w-4 h-4 text-brand-steel opacity-60" />
          </a>
        </div>

        <div class="bg-slate-50 border border-slate-200 p-5 rounded-brand space-y-3 text-xs text-brand-steel leading-relaxed">
          <h4 class="font-bold text-brand-dark text-sm flex items-center gap-1.5">
            <CheckCircle2 class="w-4 h-4 text-brand-steel" /> Benötigte Unterlagen für den BDS Landesverband:
          </h4>
          <ul class="list-disc list-inside space-y-1 pl-1">
            <li>Polizeiliches Führungszeugnis (Belegart NE / zur Vorlage beim Verein)</li>
            <li>2 Passbilder</li>
            <li><strong>Vereins-/Gruppen-Nr.:</strong> 791 | <strong>Name:</strong> BDS-Schützen SG Gersfeld e.V.</li>
          </ul>
          <p class="pt-1 text-slate-500">
            * Der Beitrag an den Landesverband wird zentral über unseren Verein abgerechnet. Du musst keinen gesonderten Zahlungsnachweis beilegen.
          </p>
        </div>

        {/* Wechsel von anderem BDS Verein */}
        <div class="p-4 rounded-brand bg-white border border-brand-border/70 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs">
          <div>
            <span class="font-bold text-brand-dark block">Bereits Mitglied im BDS LV Hessen?</span>
            <span class="text-brand-muted">Fülle diesen Änderungsantrag aus und sende ihn mit deinem Ausweis an den BDS Hessen.</span>
          </div>
          <a 
            href="https://bdshessen.de/wp-content/uploads/2022/04/BDS_Aenderungsantrag.pdf" 
            target="_blank" 
            rel="noopener noreferrer"
            class="shrink-0 inline-flex items-center gap-1.5 px-3 py-1.5 rounded bg-brand-bg hover:bg-slate-200 text-brand-steel font-bold transition-colors"
          >
            <Download class="w-3.5 h-3.5" /> BDS Änderungsantrag (PDF)
          </a>
        </div>
      </div>

    </div>

  </div>

</Layout>

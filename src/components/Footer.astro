---
import { Target, Users, Mail, Shield, BookOpen, Calendar, ExternalLink, FileText } from 'lucide-react';
---

<footer class="bg-brand-dark text-slate-400 py-16 border-t border-slate-800">
  <div class="max-w-7xl mx-auto px-6 grid grid-cols-1 md:grid-cols-4 gap-12">
    
    <!-- Col 1: Club Info -->
    <div class="space-y-4">
      <h3 class="font-extrabold text-white text-lg tracking-tight">
        SG Gersfeld 1813 e.V.
      </h3>
      <p class="text-sm leading-relaxed text-slate-400">
        Mitglied im Hessischen Schützenverband & Bund Deutscher Sportschützen. Tradition und moderner Schießsport im Herzen der Rhön.
      </p>
    </div>

    <!-- Col 2: Shortcuts -->
    <div class="space-y-4">
      <h4 class="font-bold text-white text-sm uppercase tracking-wider">
        Schnellzugriff
      </h4>
      <ul class="space-y-2.5 text-sm font-semibold">
        <li>
          <a href="/verein/schiesszeiten/" class="hover:text-white transition-colors flex items-center gap-2">
            <Target class="w-4 h-4 opacity-70" /> Schießzeiten
          </a>
        </li>
        <li>
          <a href="https://dp.sg-gersfeld.de/" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors flex items-center gap-2">
            <Calendar class="w-4 h-4 opacity-70" /> Dienstplan <ExternalLink class="w-3 h-3 opacity-50 ml-0.5" />
          </a>
        </li>
        <li>
          <a href="/verein/mitglied-werden/" class="hover:text-white transition-colors flex items-center gap-2">
            <Users class="w-4 h-4 opacity-70" /> Mitglied werden
          </a>
        </li>
        <li>
          <a href="/verein/vorstand/" class="hover:text-white transition-colors flex items-center gap-2">
            <Users class="w-4 h-4 opacity-70" /> Vorstand
          </a>
        </li>
        <li>
          <a href="/faq/" class="hover:text-white transition-colors flex items-center gap-2">
            <BookOpen class="w-4 h-4 opacity-70" /> Häufige Fragen (FAQ)
          </a>
        </li>
      </ul>
    </div>

    <!-- Col 3: Legal -->
    <div class="space-y-4">
      <h4 class="font-bold text-white text-sm uppercase tracking-wider">
        Rechtliches
      </h4>
      <ul class="space-y-2.5 text-sm font-semibold">
        <li>
          <a href="/impressum/" class="hover:text-white transition-colors flex items-center gap-2">
            <Shield class="w-4 h-4 opacity-70" /> Impressum
          </a>
        </li>
        <li>
          <a href="/datenschutz/" class="hover:text-white transition-colors flex items-center gap-2">
            <Shield class="w-4 h-4 opacity-70" /> Datenschutz
          </a>
        </li>
        <li>
          <a href="/videoueberwachung/" class="hover:text-white transition-colors flex items-center gap-2">
            <Shield class="w-4 h-4 opacity-70" /> Videoüberwachung
          </a>
        </li>
        <li>
          <a href="/verein/satzung/" class="hover:text-white transition-colors flex items-center gap-2">
            <BookOpen class="w-4 h-4 opacity-70" /> Satzung
          </a>
        </li>
      </ul>
    </div>

    <!-- Col 4: Contact info -->
    <div class="space-y-4">
      <h4 class="font-bold text-white text-sm uppercase tracking-wider">
        Kontakt
      </h4>
      <p class="text-sm text-slate-400 leading-relaxed">
        Schützengesellschaft Gersfeld 1813 e.V.<br />
        Rommerser Str. 32<br />
        36129 Gersfeld (Rhön)
      </p>
      <div class="pt-2 space-y-2">
        <a href="mailto:info@sg-gersfeld.de" class="hover:text-white text-sm font-bold text-slate-300 flex items-center gap-2 transition-colors">
          <Mail class="w-4 h-4 text-brand-steel" /> info@sg-gersfeld.de
        </a>
        <a href="mailto:rechnung@sg-gersfeld.de" class="hover:text-white text-xs font-semibold text-slate-400 flex items-center gap-2 transition-colors">
          <FileText class="w-3.5 h-3.5 text-brand-steel" /> rechnung@sg-gersfeld.de
        </a>
      </div>
    </div>

  </div>

  <div class="max-w-7xl mx-auto px-6 mt-16 pt-8 border-t border-slate-800/60 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs font-semibold text-slate-500">
    <p>
      &copy; {new Date().getFullYear()} Schützengesellschaft Gersfeld 1813 e.V. Alle Rechte vorbehalten.
    </p>
    <p>
      Erstellt mit <a href="https://astro.build" target="_blank" class="hover:text-slate-400">Astro & Tailwind</a>
    </p>
  </div>
</footer>
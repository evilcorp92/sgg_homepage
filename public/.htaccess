# ==============================================================================
# SG Gersfeld 1813 e.V. - High Performance & Security .htaccess
# ==============================================================================

# 1. Gzip / Deflate Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml application/xml application/xhtml+xml
</IfModule>

# 2. Browser Caching & Expiration Policies
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  # HTML & Dynamic JSON - no caching to ensure fresh content updates
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/json "access plus 0 seconds"

  # Images & Icons - 1 Year Cache
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"

  # Web Fonts - 1 Year Cache
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType application/font-woff "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"
  ExpiresByType application/x-font-ttf "access plus 1 year"

  # CSS & JavaScript - 1 Year Cache (Fingerprinted by Astro)
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
</IfModule>

# 3. Cache-Control Headers
<IfModule mod_headers.c>
  # 1 Year Immutable Cache for hashed assets, fonts and images
  <FilesMatch "\.(ico|pdf|jpg|jpeg|png|gif|webp|avif|svg|js|css|woff|woff2|ttf)$">
    Header set Cache-Control "max-age=31536000, public, immutable"
  </FilesMatch>

  # HTML must revalidate
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "max-age=0, no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # Security Headers
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# 4. UTF-8 Encoding
AddDefaultCharset UTF-8

# 5. Redirect legacy Aufnahmeantrag PDF URL to the new GDPR-compliant PDF
<IfModule mod_alias.c>
  Redirect 301 /wp-content/uploads/2022/02/Aufnahmeantrag.pdf /downloads/Aufnahmeantrag_SG_Gersfeld.pdf
</IfModule>
